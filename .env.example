VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web Push. Optional: without it reminders still work, but only while a tab is
# open. Generate a pair, put the public half here and in Vercel, and the private
# half in the Edge Function secrets — never here.
# See supabase/functions/send-reminders/README.md
VITE_VAPID_PUBLIC_KEY=

# The public origin, used for absolute og: URLs in index.html. Optional:
# without it the social card falls back to root-relative paths.
VITE_SITE_URL=
