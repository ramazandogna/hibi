{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["src/sw.ts"],
  "compilerOptions": {
    // A service worker has no DOM and its own globals, so it cannot share the
    // app's lib set — hence a project of its own rather than an exclusion.
    "lib": ["ESNext", "WebWorker"],
    "types": ["vite-plugin-pwa/client"],
    "strict": true,
    "moduleResolution": "bundler",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.sw.tsbuildinfo"
  }
}
